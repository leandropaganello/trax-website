---
---

<section class="kontakt" id="kontakt">
  <div class="container">
    <div class="kontakt-card">
      <div class="kontakt-content">
        <span class="section-tag">Kontakt</span>
        <h2 class="kontakt-title">Schreib uns gerne!</h2>
        <p class="kontakt-text">
          Feedback, Fragen oder einfach Hallo sagen &mdash; wir freuen uns.
        </p>
        <div class="kontakt-links">
          <a href="mailto:trax@credo-gemeinde.de" class="contact-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            feedback@traxjedenfreitag.de
          </a>
          <a href="https://traxjedenfreitag.de/public/trax" target="_blank" class="contact-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            AzuraCast Dashboard
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <div class="footer-inner">
      <img src="/trax-logo.svg" alt="TRAX" height="24" class="footer-logo" />
      <span class="footer-copy">&copy; 2026 TRAX Jugendkirche &mdash; CREDO-Kirche</span>
      <span class="footer-made">Made with <span class="heart">&hearts;</span></span>
    </div>
  </div>
</footer>

<style>
  .kontakt {
    padding: 80px 0;
  }

  .kontakt-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-lg);
    padding: 56px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .kontakt-card::before {
    content: '';
    position: absolute;
    top: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(221, 81, 25, 0.1) 0%, transparent 70%);
    filter: blur(60px);
  }

  .section-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--trax-orange);
    margin-bottom: 12px;
  }

  .kontakt-title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 800;
    margin-bottom: 12px;
  }

  .kontakt-text {
    color: var(--text-secondary);
    margin-bottom: 28px;
  }

  .kontakt-links {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    font-size: 0.9rem;
    color: var(--text-secondary);
    transition: var(--transition);
  }

  .contact-btn:hover {
    background: rgba(221, 81, 25, 0.1);
    border-color: rgba(221, 81, 25, 0.25);
    color: var(--trax-orange-light);
  }

  .footer {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 24px 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .footer-made {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .heart {
    color: var(--trax-orange);
  }

  @media (max-width: 768px) {
    .kontakt-card {
      padding: 40px 24px;
    }

    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
