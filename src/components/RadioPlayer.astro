---
const API_URL = 'https://azura.traxjedenfreitag.de/api/nowplaying/1';
const STREAM_URL = 'https://azura.traxjedenfreitag.de/listen/trax/radio.mp3';
---

<div class="player-wrapper" id="player-wrapper">
  <div class="player-art-container">
    <div class="art-ring"></div>
    <div class="art-ring ring-2"></div>
    <img
      id="player-art"
      src="/trax-profilbild.png"
      alt="Album Art"
      class="player-art"
    />
    <div class="live-badge" id="live-badge">
      <span class="live-dot"></span>
      LIVE
    </div>
  </div>

  <div class="player-info">
    <div class="player-station">
      <span class="station-badge">TRAX GOTTESDIENST</span>
      <span class="listener-count" id="listener-count">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span id="listeners">0</span> Zuhörer
      </span>
    </div>

    <div class="song-info">
      <h2 class="song-title" id="song-title">Laden...</h2>
      <p class="song-artist" id="song-artist"></p>
    </div>

    <div class="player-controls">
      <button class="play-btn" id="play-btn" aria-label="Play/Pause">
        <svg class="icon-play" id="icon-play" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        <svg class="icon-pause" id="icon-pause" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" style="display:none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
      </button>

      <div class="volume-control">
        <button class="volume-btn" id="volume-btn" aria-label="Stummschalten">
          <svg id="vol-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
          <svg id="vol-mute" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
        </button>
        <input
          type="range"
          class="volume-slider"
          id="volume-slider"
          min="0"
          max="100"
          value="80"
        />
      </div>
    </div>

    <div class="player-quality">
      <span class="quality-badge">192 kbps</span>
      <span class="quality-badge">MP3</span>
      <span class="quality-badge" id="status-badge">Offline</span>
    </div>
  </div>

  <audio id="audio-player" preload="none"></audio>
</div>

<script define:vars={{ API_URL, STREAM_URL }}>
  const audio = document.getElementById('audio-player');
  const playBtn = document.getElementById('play-btn');
  const iconPlay = document.getElementById('icon-play');
  const iconPause = document.getElementById('icon-pause');
  const volumeSlider = document.getElementById('volume-slider');
  const volumeBtn = document.getElementById('volume-btn');
  const volIcon = document.getElementById('vol-icon');
  const volMute = document.getElementById('vol-mute');
  const songTitle = document.getElementById('song-title');
  const songArtist = document.getElementById('song-artist');
  const playerArt = document.getElementById('player-art');
  const listenersEl = document.getElementById('listeners');
  const liveBadge = document.getElementById('live-badge');
  const statusBadge = document.getElementById('status-badge');
  const artRing = document.querySelector('.art-ring');

  let isPlaying = false;
  let isMuted = false;
  let previousVolume = 80;

  audio.src = STREAM_URL;
  audio.volume = 0.8;

  function setPlaying(playing) {
    isPlaying = playing;
    iconPlay.style.display = playing ? 'none' : 'block';
    iconPause.style.display = playing ? 'block' : 'none';
    if (artRing) {
      artRing.style.animationPlayState = playing ? 'running' : 'paused';
    }
  }

  playBtn.addEventListener('click', () => {
    if (isPlaying) {
      audio.pause();
      setPlaying(false);
    } else {
      audio.load();
      audio.play().then(() => setPlaying(true)).catch(() => {});
    }
  });

  audio.addEventListener('playing', () => setPlaying(true));
  audio.addEventListener('pause', () => setPlaying(false));
  audio.addEventListener('error', () => setPlaying(false));

  volumeSlider.addEventListener('input', (e) => {
    const vol = e.target.value / 100;
    audio.volume = vol;
    isMuted = vol === 0;
    updateVolumeIcon();
  });

  volumeBtn.addEventListener('click', () => {
    if (isMuted) {
      audio.volume = previousVolume / 100;
      volumeSlider.value = previousVolume;
      isMuted = false;
    } else {
      previousVolume = volumeSlider.value;
      audio.volume = 0;
      volumeSlider.value = 0;
      isMuted = true;
    }
    updateVolumeIcon();
  });

  function updateVolumeIcon() {
    volIcon.style.display = isMuted ? 'none' : 'block';
    volMute.style.display = isMuted ? 'block' : 'none';
  }

  async function fetchNowPlaying() {
    try {
      const res = await fetch(API_URL);
      const data = await res.json();

      const song = data.now_playing?.song;
      const live = data.live;
      const listeners = data.listeners;
      const isLive = live?.is_live || false;
      const isOnline = data.is_online || false;

      if (song && song.title && song.title !== 'Station Offline') {
        songTitle.textContent = song.title;
        songArtist.textContent = song.artist || '';
        if (song.art) {
          playerArt.src = song.art;
        }
      } else if (isLive) {
        songTitle.textContent = 'Live Gottesdienst';
        songArtist.textContent = live?.streamer_name || 'TRAX jeden Freitag';
      } else {
        songTitle.textContent = 'Warten auf Gottesdienst...';
        songArtist.textContent = '';
      }

      if (listeners) {
        listenersEl.textContent = listeners.current || 0;
      }

      if (isLive) {
        liveBadge.style.display = 'flex';
        statusBadge.textContent = 'Live';
        statusBadge.style.background = 'rgba(239, 68, 68, 0.15)';
        statusBadge.style.color = '#f87171';
      } else {
        liveBadge.style.display = 'none';
        statusBadge.textContent = 'Offline';
        statusBadge.style.background = 'rgba(100, 100, 100, 0.15)';
        statusBadge.style.color = '#888';
      }
    } catch (e) {
      console.error('API Error:', e);
    }
  }

  fetchNowPlaying();
  setInterval(fetchNowPlaying, 15000);
</script>

<style>
  .player-wrapper {
    display: flex;
    align-items: center;
    gap: 40px;
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 24px;
    padding: 40px;
    position: relative;
    overflow: hidden;
    max-width: 900px;
    width: 100%;
  }

  .player-wrapper::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 20% 50%, rgba(221, 81, 25, 0.06) 0%, transparent 60%);
    pointer-events: none;
  }

  .player-art-container {
    position: relative;
    flex-shrink: 0;
  }

  .art-ring {
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    border: 2px solid rgba(221, 81, 25, 0.2);
    animation: spin 8s linear infinite;
    animation-play-state: paused;
  }

  .ring-2 {
    inset: -24px;
    border-color: rgba(221, 81, 25, 0.08);
    animation-duration: 12s;
    animation-direction: reverse;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .player-art {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4);
  }

  .live-badge {
    display: none;
    align-items: center;
    gap: 6px;
    position: absolute;
    top: -4px;
    right: -4px;
    background: #ef4444;
    color: white;
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    background: white;
    border-radius: 50%;
    animation: pulse 1.5s ease-in-out infinite;
  }

  .player-info {
    flex: 1;
    min-width: 0;
    position: relative;
  }

  .player-station {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .station-badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--trax-orange);
    background: rgba(221, 81, 25, 0.1);
    padding: 4px 12px;
    border-radius: 100px;
  }

  .listener-count {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .song-info {
    margin-bottom: 24px;
  }

  .song-title {
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .song-artist {
    font-size: 1rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .player-controls {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 16px;
  }

  .play-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--trax-orange);
    border: none;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
    flex-shrink: 0;
  }

  .play-btn:hover {
    background: var(--trax-orange-dark);
    transform: scale(1.05);
    box-shadow: 0 4px 20px rgba(221, 81, 25, 0.4);
  }

  .play-btn:active {
    transform: scale(0.97);
  }

  .volume-control {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    max-width: 200px;
  }

  .volume-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
    display: flex;
    transition: var(--transition);
  }

  .volume-btn:hover {
    color: var(--text-primary);
  }

  .volume-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }

  .volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--trax-orange);
    cursor: pointer;
    transition: var(--transition);
  }

  .volume-slider::-webkit-slider-thumb:hover {
    transform: scale(1.3);
    box-shadow: 0 0 10px rgba(221, 81, 25, 0.5);
  }

  .volume-slider::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--trax-orange);
    cursor: pointer;
    border: none;
  }

  .player-quality {
    display: flex;
    gap: 8px;
  }

  .quality-badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .player-wrapper {
      flex-direction: column;
      text-align: center;
      padding: 32px 24px;
      gap: 24px;
    }

    .player-art {
      width: 140px;
      height: 140px;
    }

    .player-station {
      justify-content: center;
    }

    .song-title {
      font-size: 1.3rem;
    }

    .player-controls {
      justify-content: center;
    }

    .volume-control {
      max-width: 150px;
    }

    .player-quality {
      justify-content: center;
    }
  }
</style>
